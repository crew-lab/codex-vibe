@@ -0,0 +1,23 @@
+import { test } from 'node:test'
+import { strict as assert } from 'node:assert'
+import { qualifiesForFreeDelivery } from './delivery.mjs'
+
+test('returns false for 99', () => {
+  assert.equal(qualifiesForFreeDelivery(99), false)
+})
+
+test('returns true for 100', () => {
+  assert.equal(qualifiesForFreeDelivery(100), true)
+})
+
+test('returns true for 101', () => {
+  assert.equal(qualifiesForFreeDelivery(101), true)
+})
+
+test('returns false for 99.99', () => {
+  assert.equal(qualifiesForFreeDelivery(99.99), false)
+})
+
+test('returns true for 100.01', () => {
+  assert.equal(qualifiesForFreeDelivery(100.01), true)
+})
