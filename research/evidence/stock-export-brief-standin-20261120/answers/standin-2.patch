diff --git a/src/stock-export.mjs b/src/stock-export.mjs
new file mode 100644
index 0000000..ec533c6
--- /dev/null
+++ b/src/stock-export.mjs
@@ -0,0 +1,16 @@
+import { mkdirSync, writeFileSync } from 'node:fs';
+
+export function stockCsv(stock) {
+  const rows = [...stock.keys()].sort().map((sku) => {
+    const { available, reserved } = stock.get(sku);
+    return `${sku},${available},${reserved}`;
+  });
+  return ['sku,available,reserved', ...rows].map((line) => `${line}\n`).join('');
+}
+
+export function writeStockExport(stock, { outDir }) {
+  const file = `${outDir}/stock.csv`;
+  mkdirSync(outDir, { recursive: true });
+  writeFileSync(file, stockCsv(stock));
+  return file;
+}
diff --git a/tests/stock-export.test.mjs b/tests/stock-export.test.mjs
new file mode 100644
index 0000000..3685eb9
--- /dev/null
+++ b/tests/stock-export.test.mjs
@@ -0,0 +1,63 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { spawnSync } from 'node:child_process';
+import { existsSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from 'node:fs';
+import os from 'node:os';
+import { join } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { createStock, reserve } from '../src/inventory.mjs';
+import { stockCsv } from '../src/stock-export.mjs';
+
+const cliPath = fileURLToPath(new URL('../bin/orders.mjs', import.meta.url));
+
+function makeRoot() {
+  return mkdtempSync(join(os.tmpdir(), 'orders-export-'));
+}
+
+test('stockCsv lists reserved quantities after a reserve', () => {
+  const stock = createStock([['pear', 3], ['apple', 5]]);
+  reserve(stock, 'apple', 2);
+  assert.equal(stockCsv(stock), 'sku,available,reserved\napple,3,2\npear,3,0\n');
+});
+
+test('export writes stock.csv into a new directory', () => {
+  const root = makeRoot();
+  try {
+    const stockFile = join(root, 'stock.json');
+    writeFileSync(stockFile, '{"pear": 3, "apple": 5}');
+    const outDir = join(root, 'out', 'nested');
+    const result = spawnSync(process.execPath, [cliPath, 'export', stockFile, '--out-dir', outDir], { encoding: 'utf8' });
+    assert.equal(result.status, 0);
+    assert.equal(result.stdout, `wrote ${outDir}/stock.csv\n`);
+    assert.equal(readFileSync(join(outDir, 'stock.csv'), 'utf8'), 'sku,available,reserved\napple,5,0\npear,3,0\n');
+  } finally {
+    rmSync(root, { recursive: true, force: true });
+  }
+});
+
+test('export without --out-dir exits 2 with the exact message and writes nothing', () => {
+  const root = makeRoot();
+  try {
+    const stockFile = join(root, 'stock.json');
+    writeFileSync(stockFile, '{"apple": 5}');
+    const result = spawnSync(process.execPath, [cliPath, 'export', stockFile], { encoding: 'utf8' });
+    assert.equal(result.status, 2);
+    assert.equal(result.stderr, 'orders export: --out-dir is required\n');
+    assert.equal(existsSync(join(root, 'stock.csv')), false);
+  } finally {
+    rmSync(root, { recursive: true, force: true });
+  }
+});
+
+test('export without a stock file exits 2 with the exact message and creates no directory', () => {
+  const root = makeRoot();
+  try {
+    const outDir = join(root, 'out');
+    const result = spawnSync(process.execPath, [cliPath, 'export', '--out-dir', outDir], { encoding: 'utf8' });
+    assert.equal(result.status, 2);
+    assert.equal(result.stderr, 'orders export: a stock file is required\n');
+    assert.equal(existsSync(outDir), false);
+  } finally {
+    rmSync(root, { recursive: true, force: true });
+  }
+});
