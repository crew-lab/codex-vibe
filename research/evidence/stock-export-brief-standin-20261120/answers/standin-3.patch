diff --git a/src/stock-export.mjs b/src/stock-export.mjs
new file mode 100644
index 0000000..8e420ae
--- /dev/null
+++ b/src/stock-export.mjs
@@ -0,0 +1,18 @@
+import { mkdirSync, writeFileSync } from 'node:fs';
+import { join } from 'node:path';
+
+export function stockCsv(stock) {
+  const skus = [...stock.keys()].sort((a, b) => (a < b ? -1 : a > b ? 1 : 0));
+  const lines = skus.map((sku) => {
+    const { available, reserved } = stock.get(sku);
+    return `${sku},${available},${reserved}`;
+  });
+  return ['sku,available,reserved', ...lines].map((line) => `${line}\n`).join('');
+}
+
+export function writeStockExport(stock, { outDir }) {
+  const file = join(outDir, 'stock.csv');
+  mkdirSync(outDir, { recursive: true });
+  writeFileSync(file, stockCsv(stock));
+  return file;
+}
diff --git a/tests/stock-export.test.mjs b/tests/stock-export.test.mjs
new file mode 100644
index 0000000..691f525
--- /dev/null
+++ b/tests/stock-export.test.mjs
@@ -0,0 +1,62 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { spawnSync } from 'node:child_process';
+import { existsSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { createStock, reserve } from '../src/inventory.mjs';
+import { stockCsv } from '../src/stock-export.mjs';
+
+const cliPath = fileURLToPath(new URL('../bin/orders.mjs', import.meta.url));
+
+function runCli(args) {
+  return spawnSync(process.execPath, [cliPath, ...args], { encoding: 'utf8' });
+}
+
+test('stockCsv lists SKUs in order with reserved quantities', () => {
+  const stock = createStock([['pear', 3], ['apple', 5]]);
+  reserve(stock, 'apple', 2);
+  assert.equal(stockCsv(stock), 'sku,available,reserved\napple,3,2\npear,3,0\n');
+});
+
+test('the CLI writes stock.csv into a new directory', () => {
+  const dir = mkdtempSync(join(tmpdir(), 'stock-export-'));
+  try {
+    const stockFile = join(dir, 'stock.json');
+    writeFileSync(stockFile, JSON.stringify({ pear: 3, apple: 5 }));
+    const outDir = join(dir, 'nested', 'out');
+    const result = runCli(['export', stockFile, '--out-dir', outDir]);
+    assert.equal(result.status, 0);
+    assert.equal(readFileSync(join(outDir, 'stock.csv'), 'utf8'), 'sku,available,reserved\napple,5,0\npear,3,0\n');
+  } finally {
+    rmSync(dir, { recursive: true, force: true });
+  }
+});
+
+test('the CLI refuses a missing --out-dir', () => {
+  const dir = mkdtempSync(join(tmpdir(), 'stock-export-'));
+  try {
+    const stockFile = join(dir, 'stock.json');
+    writeFileSync(stockFile, JSON.stringify({ apple: 5 }));
+    const result = runCli(['export', stockFile]);
+    assert.equal(result.status, 2);
+    assert.equal(result.stderr, 'orders export: --out-dir is required\n');
+    assert.equal(existsSync(join(dir, 'stock.csv')), false);
+  } finally {
+    rmSync(dir, { recursive: true, force: true });
+  }
+});
+
+test('the CLI refuses a missing stock file', () => {
+  const dir = mkdtempSync(join(tmpdir(), 'stock-export-'));
+  try {
+    const outDir = join(dir, 'out');
+    const result = runCli(['export', '--out-dir', outDir]);
+    assert.equal(result.status, 2);
+    assert.equal(result.stderr, 'orders export: a stock file is required\n');
+    assert.equal(existsSync(outDir), false);
+  } finally {
+    rmSync(dir, { recursive: true, force: true });
+  }
+});
