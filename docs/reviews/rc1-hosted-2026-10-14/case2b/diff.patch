diff --git a/.github/workflows/rollback.yml b/.github/workflows/rollback.yml
index 2655a0c..5b00c36 100644
--- a/.github/workflows/rollback.yml
+++ b/.github/workflows/rollback.yml
@@ -52,9 +52,43 @@ jobs:
       - name: Download and verify prior release
         run: |
           mkdir release-artifact release-artifact/release
-          aws s3 cp "s3://${AWS_RELEASES_BUCKET}/releases/${RELEASE_SHA}/site.tar.gz" release-artifact/site.tar.gz --only-show-errors
-          aws s3 cp "s3://${AWS_RELEASES_BUCKET}/releases/${RELEASE_SHA}/site.tar.gz.sha256" release-artifact/site.tar.gz.sha256 --only-show-errors
-          (cd release-artifact && shasum -a 256 -c site.tar.gz.sha256 && tar -xzf site.tar.gz -C release)
+          aws s3 cp "s3://${AWS_RELEASES_BUCKET}/releases/${RELEASE_SHA}/site.tar.gz" "release-artifact/garnebo-site-${RELEASE_SHA}.tar.gz" --only-show-errors
+          aws s3 cp "s3://${AWS_RELEASES_BUCKET}/releases/${RELEASE_SHA}/site.tar.gz.sha256" "release-artifact/garnebo-site-${RELEASE_SHA}.tar.gz.sha256" --only-show-errors
+
+          # Validate checksum file format strictly before verification
+          CHECKSUM_FILE="release-artifact/garnebo-site-${RELEASE_SHA}.tar.gz.sha256"
+          EXPECTED_BASENAME="garnebo-site-${RELEASE_SHA}.tar.gz"
+          EXPECTED_SIZE=$((64 + 2 + ${#EXPECTED_BASENAME} + 1))
+
+          ACTUAL_SIZE=$(wc -c < "$CHECKSUM_FILE")
+          if [ "$ACTUAL_SIZE" -ne "$EXPECTED_SIZE" ]; then
+            echo "::error::Checksum file size is ${ACTUAL_SIZE} bytes, expected ${EXPECTED_SIZE}"
+            exit 1
+          fi
+
+          if [ "$(tail -c 1 "$CHECKSUM_FILE" | od -An -tx1 | tr -d ' ')" != "0a" ]; then
+            echo "::error::Checksum file must end with exactly one LF"
+            exit 1
+          fi
+
+          if grep -qP '\r' "$CHECKSUM_FILE"; then
+            echo "::error::Checksum file contains CRLF"
+            exit 1
+          fi
+
+          HEADER=$(head -c $((64 + 2)) "$CHECKSUM_FILE")
+          if ! echo "$HEADER" | grep -qP '^[0-9a-f]{64}  $'; then
+            echo "::error::Checksum digest or spaces are malformed"
+            exit 1
+          fi
+
+          BASENAME=$(head -c $((EXPECTED_SIZE - 1)) "$CHECKSUM_FILE" | tail -c ${#EXPECTED_BASENAME})
+          if [ "$BASENAME" != "$EXPECTED_BASENAME" ]; then
+            echo "::error::Checksum file basename does not match expected archive name"
+            exit 1
+          fi
+
+          (cd release-artifact && shasum -a 256 -c "garnebo-site-${RELEASE_SHA}.tar.gz.sha256" && tar -xzf "garnebo-site-${RELEASE_SHA}.tar.gz" -C release)
         env:
           AWS_RELEASES_BUCKET: ${{ vars.AWS_RELEASES_BUCKET }}
           RELEASE_SHA: ${{ inputs.release_sha }}
