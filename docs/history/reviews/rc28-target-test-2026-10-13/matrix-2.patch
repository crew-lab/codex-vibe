@@ -0,0 +1,28 @@
+import { strict as assert } from 'node:assert';
+import { describe, test } from 'node:test';
+import { atLeast } from '../src/at-least.mjs';
+
+const { equal } = assert;
+
+describe('atLeast', () => {
+  test('below', () => {
+    equal(atLeast(3, 5), false);
+    equal(atLeast(-10, -5), false);
+  });
+
+  test('equal', () => {
+    equal(atLeast(5, 5), true);
+    equal(atLeast(-5, -5), true);
+    equal(atLeast(0, 0), true);
+  });
+
+  test('above', () => {
+    equal(atLeast(7, 5), true);
+    equal(atLeast(-5, -10), true);
+  });
+
+  test('negatives', () => {
+    equal(atLeast(-3, -5), true);
+    equal(atLeast(-5, -3), false);
+  });
+});
