@@ -0,0 +1 @@
+export function atLeast(value, limit) { return value >= limit; }
diff --git a/tests/at-least.test.mjs b/tests/at-least.test.mjs
new file mode 100644
index 0000000..eb87a26
--- /dev/null
+++ b/tests/at-least.test.mjs
@@ -0,0 +1,27 @@
+import { strict as assert } from 'node:assert';
+import { test } from 'node:test';
+import { atLeast } from '../src/at-least.mjs';
+
+test('atLeast returns false when value is below limit', () => {
+  assert.equal(atLeast(5, 10), false);
+});
+
+test('atLeast returns true when value equals limit', () => {
+  assert.equal(atLeast(10, 10), true);
+});
+
+test('atLeast returns true when value is above limit', () => {
+  assert.equal(atLeast(15, 10), true);
+});
+
+test('atLeast handles negative values: -5 >= -10', () => {
+  assert.equal(atLeast(-5, -10), true);
+});
+
+test('atLeast handles negative equality: -10 >= -10', () => {
+  assert.equal(atLeast(-10, -10), true);
+});
+
+test('atLeast handles negative below: -15 < -10', () => {
+  assert.equal(atLeast(-15, -10), false);
+});
