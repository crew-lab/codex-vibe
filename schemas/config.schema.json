{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-supervisor.local/schemas/config.schema.json",
  "title": "Vibe Supervisor configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version"],
  "properties": {
    "version": { "const": 1 },
    "backend": { "enum": ["auto", "acp", "programmatic"], "default": "programmatic" },
    "allowed_workspace_roots": { "type": "array", "maxItems": 100, "items": { "type": "string", "minLength": 1, "maxLength": 4096 }, "default": [] },
    "max_concurrent_runs": { "type": "integer", "minimum": 1, "maximum": 32, "default": 2 },
    "max_queued_runs": { "type": "integer", "minimum": 0, "maximum": 256, "default": 8 },
    "worker_idle_ttl_seconds": { "type": "integer", "minimum": 0, "maximum": 86400, "default": 600 },
    "retention": {
      "type": "object", "additionalProperties": false,
      "properties": { "days": { "type": "integer", "minimum": 0, "maximum": 3650, "default": 7 }, "preserve_failed_runs": { "type": "boolean", "default": true } }
    },
    "limits": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "review_timeout_seconds": { "type": "integer", "minimum": 30, "maximum": 7200, "default": 1800 },
        "edit_timeout_seconds": { "type": "integer", "minimum": 30, "maximum": 7200, "default": 2400 },
        "max_turns_review": { "type": "integer", "minimum": 1, "maximum": 50, "default": 12 },
        "max_turns_edit": { "type": "integer", "minimum": 1, "maximum": 50, "default": 20 },
        "max_event_bytes": { "type": "integer", "minimum": 1024, "maximum": 1073741824, "default": 52428800 },
        "max_transcript_bytes": { "type": "integer", "minimum": 1024, "maximum": 1073741824, "default": 10485760 },
        "max_artifact_bytes": { "type": "integer", "minimum": 1024, "maximum": 2147483648, "default": 104857600 },
        "max_mcp_result_chars": { "type": "integer", "minimum": 1000, "maximum": 1000000, "default": 50000 }
      }
    },
    "phase1": { "type": "object", "additionalProperties": false, "properties": { "allow_temporary_trust": { "type": "boolean", "default": false } } },
    "security": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "allow_shell_in_review": { "type": "boolean", "default": false },
        "allow_shell_in_edit": { "type": "boolean", "default": false },
        "allow_network_tools": { "type": "boolean", "default": false },
        "log_raw_acp": { "type": "boolean", "default": false },
        "persist_reasoning": { "const": false, "default": false }
      }
    },
    "paths": { "type": "object", "additionalProperties": false, "properties": { "vibe": { "type": "string", "minLength": 1 }, "vibe_acp": { "type": "string", "minLength": 1 }, "data_dir": { "type": "string", "minLength": 1 } } }
  }
}
