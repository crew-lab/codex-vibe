{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-supervisor.local/schemas/config.schema.json",
  "title": "Vibe Supervisor configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version"],
  "properties": {
    "version": { "const": 1 },
    "allowed_workspace_roots": {
      "type": "array",
      "maxItems": 100,
      "items": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^(/|~$|~/)" },
      "default": []
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "days": { "type": "integer", "minimum": 0, "maximum": 3650, "default": 7 } }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "review_timeout_seconds": { "type": "integer", "minimum": 30, "maximum": 7200, "default": 1800 },
        "edit_timeout_seconds": { "type": "integer", "minimum": 30, "maximum": 7200, "default": 2400 },
        "max_turns_review": { "type": "integer", "minimum": 1, "maximum": 50, "default": 20 },
        "max_turns_edit": { "type": "integer", "minimum": 1, "maximum": 50, "default": 20 },
        "max_event_bytes": { "type": "integer", "minimum": 1024, "maximum": 1073741824, "default": 52428800 },
        "max_transcript_bytes": { "type": "integer", "minimum": 1024, "maximum": 1073741824, "default": 10485760 },
        "max_artifact_bytes": { "type": "integer", "minimum": 1024, "maximum": 2147483648, "default": 104857600 },
        "worker_progress_timeout_seconds": {
          "oneOf": [{ "const": 0 }, { "type": "integer", "minimum": 60, "maximum": 7200 }],
          "default": 600
        },
        "max_mcp_result_chars": { "type": "integer", "minimum": 1000, "maximum": 1000000, "default": 8000 }
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "vibe": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^(/|[^/]+$)" } }
    }
  }
}
