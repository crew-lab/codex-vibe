{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-supervisor.local/schemas/run.schema.json",
  "title": "Persisted Vibe Supervisor run record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "backend", "mode", "state", "source_workspace", "worker_workspace", "created_at", "updated_at", "task_sha256", "limits"],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": { "type": "string", "format": "uuid" },
    "backend": { "enum": ["acp", "programmatic"] },
    "mode": { "enum": ["review", "edit"] },
    "state": { "enum": ["queued", "starting", "negotiating", "ready", "running", "waiting_permission", "waiting_input", "completed", "failed", "cancelled", "closing", "closed", "orphaned", "recoverable"] },
    "source_workspace": { "type": "string" }, "worker_workspace": { "type": "string" },
    "worktree": { "type": "object", "additionalProperties": false, "required": ["path", "base_ref", "created_by_supervisor"], "properties": { "path": { "type": "string" }, "base_ref": { "type": "string" }, "created_by_supervisor": { "type": "boolean" } } },
    "created_at": { "type": "string", "format": "date-time" }, "updated_at": { "type": "string", "format": "date-time" }, "launched_at": { "type": "string", "format": "date-time" }, "started_at": { "type": "string", "format": "date-time" }, "finished_at": { "type": "string", "format": "date-time" },
    "task_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "workspace_snapshot_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "process": { "type": "object", "additionalProperties": false, "properties": { "pid": { "type": "integer" }, "executable": { "type": "string" }, "version": { "type": "string" } } },
    "acp": { "type": "object", "additionalProperties": true },
    "limits": { "type": "object", "additionalProperties": false, "required": ["timeout_seconds", "max_turns", "max_event_bytes", "max_transcript_bytes", "max_artifact_bytes"], "properties": { "timeout_seconds": { "type": "integer" }, "max_turns": { "type": "integer" }, "max_event_bytes": { "type": "integer" }, "max_transcript_bytes": { "type": "integer" }, "max_artifact_bytes": { "type": "integer" } } },
    "usage": { "type": "object", "additionalProperties": true }, "pending_request": { "type": "object", "additionalProperties": true }, "result": { "type": "object", "additionalProperties": true },
    "error": { "type": "object", "additionalProperties": false, "required": ["code", "message", "remediation", "retryable"], "properties": { "code": { "type": "string", "pattern": "^VSUP_[A-Z_]+$" }, "message": { "type": "string" }, "remediation": { "type": "string" }, "retryable": { "type": "boolean" }, "details": { "type": "object" } } }
  }
}
