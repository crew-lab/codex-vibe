{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reviewed baseline manifest input",
  "type": "object",
  "additionalProperties": false,
  "required": ["source", "baseRef", "outputParent", "entries"],
  "properties": {
    "source": { "type": "string", "minLength": 1 },
    "baseRef": { "type": "string", "minLength": 1, "maxLength": 512 },
    "outputParent": { "type": "string", "minLength": 1 },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "operation", "baseSha256", "reviewedSha256", "mode"],
            "properties": {
              "path": { "type": "string", "minLength": 1, "maxLength": 1024 },
              "operation": { "const": "add" },
              "baseSha256": { "type": "null" },
              "reviewedSha256": { "$ref": "#/$defs/sha256" },
              "mode": { "$ref": "#/$defs/mode" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "operation", "baseSha256", "reviewedSha256", "mode"],
            "properties": {
              "path": { "type": "string", "minLength": 1, "maxLength": 1024 },
              "operation": { "const": "replace" },
              "baseSha256": { "$ref": "#/$defs/sha256" },
              "reviewedSha256": { "$ref": "#/$defs/sha256" },
              "mode": { "$ref": "#/$defs/mode" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "operation", "baseSha256", "reviewedSha256"],
            "properties": {
              "path": { "type": "string", "minLength": 1, "maxLength": 1024 },
              "operation": { "const": "delete" },
              "baseSha256": { "$ref": "#/$defs/sha256" },
              "reviewedSha256": { "type": "null" }
            }
          }
        ]
      }
    },
    "publicTemplates": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "const": ".env.example" },
          "sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "mode": { "enum": ["100644", "100755"] }
  }
}
