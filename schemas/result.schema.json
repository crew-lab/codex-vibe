{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-supervisor.local/schemas/result.schema.json",
  "title": "Vibe Supervisor one-shot result",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "run_id", "state", "backend", "summary", "artifacts", "changed_files", "warnings"],
  "properties": {
    "schema_version": { "const": 1 },
    "supervisor_version": { "type": ["string", "null"] },
    "run_id": { "type": "string", "format": "uuid" },
    "state": { "enum": ["starting", "running", "completed", "failed", "cancelled", "closing", "closed"] },
    "backend": { "const": "programmatic" },
    "stop_reason": { "type": "string" },
    "summary": { "type": "string" },
    "workspace": { "type": "object", "properties": { "source": { "type": "string" }, "worker": { "type": "string" } } },
    "artifacts": {
      "type": "array",
      "items": { "type": "object", "required": ["name", "path"], "properties": { "name": { "type": "string" }, "path": { "type": "string" }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "bytes": { "type": "integer", "minimum": 0 }, "media_type": { "type": "string" } } }
    },
    "changed_files": { "type": "array", "items": { "type": "string" } },
    "changed_files_total": { "type": "integer", "minimum": 0 },
    "diff_stat": { "type": "string" },
    "patch": { "type": "string" },
    "patch_path": { "type": "string" },
    "patch_bytes": { "type": "integer", "minimum": 0 },
    "integrity": {
      "type": "object", "required": ["status", "write_tool_observed"],
      "properties": { "status": { "enum": ["verified", "changed", "unverified"] }, "write_tool_observed": { "type": "boolean" }, "changed_paths": { "type": "array", "items": { "type": "string" } }, "changed_paths_total": { "type": "integer", "minimum": 0 }, "reason": { "type": "string" } }
    },
    "usage": { "type": "object" },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "error": { "type": "object" },
    "next_action": { "type": "string" }
  }
}
