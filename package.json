{
  "name": "vibe-supervisor",
  "version": "2.2.0",
  "private": true,
  "description": "Codex MCP supervisor for delegated Mistral Vibe runs",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "bin": {
    "vibe-supervisor": "dist/cli.js"
  },
  "files": [
    "dist",
    "schemas",
    "examples",
    "skills",
    "docs",
    "README.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "LICENSE",
    "scripts/v2-conformance-check.mjs",
    "scripts/runtime-install.mjs"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration",
    "test:security": "vitest run tests/security",
    "build": "node scripts/clean-dist.mjs && tsc",
    "prepare": "npm run build",
    "acceptance": "node scripts/acceptance.mjs",
    "smoke:install": "node scripts/smoke-install.mjs",
    "sbom": "node scripts/sbom.mjs",
    "secret-scan": "node scripts/secret-scan.mjs",
    "checksum": "node scripts/checksum.mjs",
    "docs:errors": "node scripts/errors-doc.mjs",
    "package:rc": "node scripts/package-rc.mjs",
    "verify:release": "npm run lint && npm run typecheck && npm run build && npm test && npm run acceptance && npm run secret-scan && npm run sbom",
    "prepack": "npm run verify:release",
    "pack:dry-run": "npm pack --dry-run --ignore-scripts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.0",
    "smol-toml": "1.9.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.0",
    "@types/node": "20.19.43",
    "eslint": "10.12.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.1",
    "vitest": "4.0.18"
  }
}
